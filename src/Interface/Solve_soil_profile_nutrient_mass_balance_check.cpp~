#include "Basin.h"

int Basin::Solve_soil_profile_nutrient(Control &ctrl, Atmosphere &atm, Param &par){

    /* 
    ### Soil layer 1:
    (_thate1_old)
    + infiltration          (need to mix)
    - percolation1
    - Esoil
    - Transp1           
    (_thate1)
    + reinfiltration
    - repercolation1    


    ### Soil layer 2:
    (_thata2_old)
    + percolation1          (need to mix)
    - percolation2
    - Transp2           
    (_theta2)
    + repercolation1
    - repercolation2    

    ### Soil layer 3:
    (_theta3_old)           
    + percolation2          (need to mix)
    - percolation3
    - Transp3
    (_theta3)          
    + repercolation2
    - repercolation3
    + interflow_in      
    - interflow_out
    - interflow_toChn   
    */

    
    
    
    
    // ======= Mixing through layer 1-3 =======
    // flag1: enrichment due to evaportranspiration
    // flag2: drainage
    // flag3: Fickian diffusion
    // flag4: Whether solute is stable water isotope
    if (ctrl.opt_carbon_sim==1){
      Solve_soil_transport(par, *_doc_pond, *_doc_layer1, *_doc_layer2, *_doc_layer3, *_doc_vadose, *_doc_chanS, *_leaching_mass_doc, *_drainage_mass_doc, true, ctrl.opt_drainage, true, false);  
    }
    
    if (ctrl.opt_nitrogen_sim==1){
      Solve_soil_transport(par, *_no3_pond, *_no3_layer1, *_no3_layer2, *_no3_layer3, *_no3_vadose, *_no3_chanS, *_leaching_mass_no3, *_drainage_mass_no3, true, ctrl.opt_drainage, true, false);
    }


    // ======= Carbon/nitrogen biogeochemical processes =======
    if (ctrl.opt_carbon_sim==1 or ctrl.opt_nitrogen_sim==1){
      int j = 6800;
      double C_plant_1 = _plant_green_CP->val[j] + _plant_wood_CP->val[j] + _plant_reserve_CP->val[j];
      double C_litter_1 = _dpm_litter_CP1->val[j] + _rpm_litter_CP1->val[j] + _dpm_litter_CP2->val[j] + _rpm_litter_CP2->val[j] + _dpm_litter_CP3->val[j] + _rpm_litter_CP3->val[j];
      double C_soil_1 = _bio_CP1->val[j] + _humus_CP1->val[j] + _bio_CP2->val[j] + _humus_CP2->val[j] + _bio_CP3->val[j] + _humus_CP3->val[j];
      double C_soluble_1 = _doc_layer1->val[j]*_theta1->val[j]*_depth1->val[j] + _doc_layer2->val[j]*_theta2->val[j]*_depth2->val[j] + _doc_layer3->val[j]*_theta3->val[j]*par._depth3->val[j] + 
                           _soluble_CP1->val[j] + _soluble_CP2->val[j] + _soluble_CP3->val[j];;
      double N_plant_1 = (_plant_green_CP->val[j] + _plant_reserve_CP->val[j]) * par._NC_ratio_plant_green->val[j] + _plant_wood_CP->val[j] * par._NC_ratio_plant_wood->val[j];
      double N_plant_mobile_1 = _plant_mobile_NP->val[j];
      double N_litter_1 = (_dpm_litter_CP1->val[j]+_dpm_litter_CP2->val[j]+_dpm_litter_CP3->val[j]) * par._NC_ratio_dpm_litter->val[j] + (_rpm_litter_CP1->val[j]+_rpm_litter_CP2->val[j]+_rpm_litter_CP3->val[j]) * par._NC_ratio_rpm_litter->val[j];
      double N_soli_1 = C_soil_1 * _NC_ratio_soil_pool->val[j];
      double N_soluble_1 = _no3_layer1->val[j]*_theta1->val[j]*_depth1->val[j] + _no3_layer2->val[j]*_theta2->val[j]*_depth2->val[j] + _no3_layer3->val[j]*_theta3->val[j]*par._depth3->val[j];

      Carbon_addition(ctrl, par);      

      double C_plant_2 = _plant_green_CP->val[j] + _plant_wood_CP->val[j] + _plant_reserve_CP->val[j];
      double C_litter_2 = _dpm_litter_CP1->val[j] + _rpm_litter_CP1->val[j] + _dpm_litter_CP2->val[j] + _rpm_litter_CP2->val[j] + _dpm_litter_CP3->val[j] + _rpm_litter_CP3->val[j];
      double C_soil_2 = _bio_CP1->val[j] + _humus_CP1->val[j] + _bio_CP2->val[j] + _humus_CP2->val[j] + _bio_CP3->val[j] + _humus_CP3->val[j];
      double C_soluble_2 = _doc_layer1->val[j]*_theta1->val[j]*_depth1->val[j] + _doc_layer2->val[j]*_theta2->val[j]*_depth2->val[j] + _doc_layer3->val[j]*_theta3->val[j]*par._depth3->val[j]+
                           _soluble_CP1->val[j] + _soluble_CP2->val[j] + _soluble_CP3->val[j];;
      double N_plant_2 = (_plant_green_CP->val[j] + _plant_reserve_CP->val[j]) * par._NC_ratio_plant_green->val[j] + _plant_wood_CP->val[j] * par._NC_ratio_plant_wood->val[j];
      double N_plant_mobile_2 = _plant_mobile_NP->val[j];
      double N_litter_2 = (_dpm_litter_CP1->val[j]+_dpm_litter_CP2->val[j]+_dpm_litter_CP3->val[j]) * par._NC_ratio_dpm_litter->val[j] + (_rpm_litter_CP1->val[j]+_rpm_litter_CP2->val[j]+_rpm_litter_CP3->val[j]) * par._NC_ratio_rpm_litter->val[j];
      double N_soli_2 = C_soil_2 * _NC_ratio_soil_pool->val[j];
      double N_soluble_2 = _no3_layer1->val[j]*_theta1->val[j]*_depth1->val[j] + _no3_layer2->val[j]*_theta2->val[j]*_depth2->val[j] + _no3_layer3->val[j]*_theta3->val[j]*par._depth3->val[j];
      double C_balance = C_plant_2-C_plant_1 + C_litter_2-C_litter_1 + C_soil_2-C_soil_1 + C_soluble_2-C_soluble_1 - (_NPP->val[j]);
      double N_balance = N_plant_2-N_plant_1 + N_plant_mobile_2-N_plant_mobile_1 + N_litter_2-N_litter_1 + N_soli_2-N_soli_1 + N_soluble_2-N_soluble_1 - (_biological_fixiation_N->val[j]);
      /*
      cout<< "Changes in plant C: "<<C_plant_2-C_plant_1<<endl;
      cout<< "Changes in litter C: "<<C_litter_2-C_litter_1<<endl;
      cout<< "Changes in soil C: "<<C_soil_2-C_soil_1<<endl;
      cout<< "Changes in soluble C: "<<C_soluble_2-C_soluble_1<<endl;
      cout<< "NPP - litter fall: "<<_NPP->val[j] - _litter_fall_C->val[j]<<endl;
      cout<< "litter fall: "<<_litter_fall_C->val[j]<<endl;
      cout<< "Changes in plant N: "<<N_plant_2-N_plant_1<<endl;
      cout<< "Changes in litter N: "<<N_litter_2-N_litter_1<<endl;
      cout<< "Changes in plant N + litter N: "<<N_plant_2-N_plant_1 + N_litter_2-N_litter_1<<endl;
      cout<< "Changes in soil N: "<<N_soli_2-N_soli_1<<endl;
      cout<< "Changes in soluble N: "<<N_soluble_2-N_soluble_1<<endl;
      cout<< "Changes in soluble N + plant mobile N: "<<N_soluble_2-N_soluble_1 + N_plant_mobile_2-N_plant_mobile_1<<endl;
      cout<< "Changes in soluble N + plant mobile N + litter N plus fixiation: "<<N_soluble_2-N_soluble_1 + N_plant_mobile_2-N_plant_mobile_1 + N_litter_2-N_litter_1 - _biological_fixiation_N->val[j]<<endl;
      */
      cout<< "C balance - carbon_addition: "<<C_balance<<endl;
      cout<< "N balance - carbon_addition: "<<N_balance<<endl;

      Carbon_transformation(ctrl, atm, par);

      double C_plant_3 = _plant_green_CP->val[j] + _plant_wood_CP->val[j] + _plant_reserve_CP->val[j];
      double C_litter_3 = _dpm_litter_CP1->val[j] + _rpm_litter_CP1->val[j] + _dpm_litter_CP2->val[j] + _rpm_litter_CP2->val[j] + _dpm_litter_CP3->val[j] + _rpm_litter_CP3->val[j];
      double C_soil_3 = _bio_CP1->val[j] + _humus_CP1->val[j] + _bio_CP2->val[j] + _humus_CP2->val[j] + _bio_CP3->val[j] + _humus_CP3->val[j];
      double C_soluble_3 = _doc_layer1->val[j]*_theta1->val[j]*_depth1->val[j] + _doc_layer2->val[j]*_theta2->val[j]*_depth2->val[j] + _doc_layer3->val[j]*_theta3->val[j]*par._depth3->val[j] +
                           _soluble_CP1->val[j] + _soluble_CP2->val[j] + _soluble_CP3->val[j];
      double N_plant_3 = (_plant_green_CP->val[j] + _plant_reserve_CP->val[j]) * par._NC_ratio_plant_green->val[j] + _plant_wood_CP->val[j] * par._NC_ratio_plant_wood->val[j];
      double N_plant_mobile_3 = _plant_mobile_NP->val[j];
      double N_litter_3 = (_dpm_litter_CP1->val[j]+_dpm_litter_CP2->val[j]+_dpm_litter_CP3->val[j]) * par._NC_ratio_dpm_litter->val[j] + (_rpm_litter_CP1->val[j]+_rpm_litter_CP2->val[j]+_rpm_litter_CP3->val[j]) * par._NC_ratio_rpm_litter->val[j];
      double N_soli_3 = C_soil_3 * _NC_ratio_soil_pool->val[j];
      double N_soluble_3 = _no3_layer1->val[j]*_theta1->val[j]*_depth1->val[j] + _no3_layer2->val[j]*_theta2->val[j]*_depth2->val[j] + _no3_layer3->val[j]*_theta3->val[j]*par._depth3->val[j];
      C_balance = C_plant_3-C_plant_2 + C_litter_3-C_litter_2 + C_soil_3-C_soil_2 + C_soluble_3-C_soluble_2 - (-_co2_emission_C->val[j]);
      N_balance = N_plant_3-N_plant_2 + N_plant_mobile_3-N_plant_mobile_2 + N_litter_3-N_litter_2 + N_soli_3-N_soli_2 + N_soluble_3-N_soluble_2;
      //cout<< "Changes in litter C + soil C: "<<C_litter_3-C_litter_2 + C_soil_3-C_soil_2<<endl;
      //cout<< "Changes in soluble C plus co2 emission: "<<C_soluble_3-C_soluble_2 + _co2_emission_C->val[j]<<endl;
      //cout<< "Changes in litter N + soil N: "<<N_litter_3-N_litter_2 + N_soli_3-N_soli_2<<endl;
      //cout<< "Changes in soluble N: "<<N_soluble_3-N_soluble_2<<endl;
      //cout<< "Soil minerl N: "<<_soil_minerl_N->val[j]<<endl;
      cout<< "C balance - carbon_transformation: "<<C_balance<<endl;
      cout<< "N balance - carbon_transformation: "<<N_balance<<endl;
      //cout<< "CO2 emission: "<<_co2_emission_C->val[j]<<endl;

      Carbon_management(ctrl, par);
    }


    // ======= Nitrogen biogeochemical processes =======
    /* Nitrogen addtion */
    Sort_nitrogen_addition(ctrl, par);
    Nitrogen_addition(ctrl, par);
    Soil_denitrification(ctrl, atm, par);  // Denitrification
   

    return EXIT_SUCCESS;
}
